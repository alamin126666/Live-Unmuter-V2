# ════════════════════════════════════════
#   🤖 Live Auto-Unmute Bot — ENV CONFIG
#   Railway-এ এগুলো Variables সেকশনে দিন
# ════════════════════════════════════════

# ✅ Telegram Bot Token (@BotFather থেকে নিন)
BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi

# ✅ Telegram API ID (https://my.telegram.org থেকে নিন)
API_ID=12345678

# ✅ Telegram API Hash (https://my.telegram.org থেকে নিন)
API_HASH=abcdef1234567890abcdef1234567890

# ✅ আপনার Telegram User ID (Bot-এর Admin)
#    পেতে @userinfobot এ /start পাঠান
ADMIN_ID=987654321
